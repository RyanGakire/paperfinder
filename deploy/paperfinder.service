[Unit]
Description=PaperFinder web app (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/paperfinder
EnvironmentFile=-/opt/paperfinder/.env
ExecStart=/opt/paperfinder/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5000 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target